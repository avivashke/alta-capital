# Alta Capital — Base Server & Cloud Sync Configuration
# Copy this file to .env on your Base Server computer:
#   cp .env.example .env

# Server listen settings (0.0.0.0 allows phones & tablets on your Wi-Fi to connect)
HOST=0.0.0.0
PORT=8181

# Primary Cloud Database (Supabase PostgreSQL — same project used by Netlify Cloud)
SUPABASE_URL=https://lqiakdsdpdvdlobeeovz.supabase.co
SUPABASE_ANON_KEY=

# Optional: Your Netlify Cloud URL so this Base Server mirrors bidirectionally with Netlify too
# Example: CLOUD_API_URL=https://your-site.netlify.app/api/db
CLOUD_API_URL=

# Optional: Shared secret token if exposing this Base Server over the internet (e.g. Cloudflare Tunnel)
BASE_SERVER_TOKEN=

# Two-way Cloud Sync interval in seconds (default: 60)
SYNC_INTERVAL_SEC=60

# Built-in 24/7 autonomous cycle runner on this Base Server (default: true, every 15 min)
ENABLE_LOCAL_CRON=true
CRON_INTERVAL_MIN=15
CRON_CYCLES=2

# Optional AI provider keys for local Base Server autonomous cycles
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
