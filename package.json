{
  "name": "alta-capital",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-run trading research desk: backtests, walk-forward hardening, versioned bot artifacts, cross-device cloud sync, and an always-on Base Server.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "base-server": "node scripts/start-base-server.mjs",
    "base-server:restart:win": "powershell -ExecutionPolicy Bypass -File scripts/restart-base-server-windows.ps1",
    "setup:local-ai": "bash scripts/install-local-ai-unix.sh",
    "setup:local-ai:win": "powershell -ExecutionPolicy Bypass -File scripts/install-local-ai-windows.ps1",
    "setup:intel-arc:win": "powershell -ExecutionPolicy Bypass -File scripts/enable-intel-arc-windows.ps1",
    "setup:x-agent": "bash scripts/install-x-agent-unix.sh",
    "setup:x-agent:win": "powershell -ExecutionPolicy Bypass -File scripts/install-x-agent-windows.ps1",
    "x-agent:login": "node scripts/x-browser-agent.mjs --login",
    "x-agent:scan": "node scripts/x-browser-agent.mjs --scan",
    "wa-agent:status": "node scripts/whatsapp-browser-agent.mjs --status",
    "wa-agent:login": "node scripts/whatsapp-browser-agent.mjs --login",
    "wa-agent:scan": "node scripts/whatsapp-browser-agent.mjs --scan",
    "firm": "node runner/run.mjs --cycles=5",
    "firm:deep": "node runner/run.mjs --cycles=5 --deep",
    "cf:dev": "npx wrangler dev",
    "cf:deploy": "npx wrangler deploy",
    "cf:d1:init": "npx wrangler d1 execute alta-db --file=cloudflare/schema.sql",
    "cf:pages:deploy": "npx wrangler pages deploy . --project-name=alta-capital"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lightweight-charts": "^5.3.0"
  }
}
